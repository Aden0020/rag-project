{
  "name": "Tool - vector_search",
  "nodes": [
    {
      "parameters": {
        "inputSource": "jsonExample",
        "jsonExample": "{\"query\": \"creative playmaker\"}"
      },
      "id": "execute-workflow-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/embed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'nomic-embed-text', input: $json.query } }}"
      },
      "id": "embed-query",
      "name": "Embed query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = { statements: [{ statement: `\nCALL db.index.vector.queryNodes('playerChunks', 3, $embedding)\nYIELD node AS chunk, score\nMATCH (chunk)-[:FROM_DOCUMENT]->(d:Document)\nRETURN chunk.text AS text, d.name AS source, score`,\n parameters: { embedding: $json.embeddings[0] } }] };\nreturn { json: { body } };"
      },
      "id": "build-cypher",
      "name": "Build Cypher",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://neo4j:7474/db/neo4j/tx/commit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Basic bmVvNGo6cGFzc3dvcmQxMjM="
            }
          ]
        }
      },
      "id": "query-neo4j",
      "name": "Query Neo4j",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const res = $json.results ? $json.results[0] : null;\nif (!res) { throw new Error('Neo4j error: ' + JSON.stringify($json.errors)); }\nconst rows = res.data.map(d => Object.fromEntries(res.columns.map((c, i) => [c, d.row[i]])));\nreturn { json: { result: JSON.stringify(rows, null, 2) } };"
      },
      "id": "format-result",
      "name": "Format result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    }
